{
  "name": "__APP_NAME__",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.6.0",
  "scripts": {
    "build": "turbo run build --env-mode=loose",
    "heroku-postbuild": "turbo run build --env-mode=loose",
    "dev": "turbo run dev",
    "lint": "oxlint --config oxlint.json .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck",
    "generate": "turbo run generate",
    "migrate": "turbo run migrate",
    "seed": "turbo run seed",
    "reset": "turbo run reset"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4",
    "oxlint": "^1",
    "turbo": "^2",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^4"
  }
}
